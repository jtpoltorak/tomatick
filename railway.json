{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "public/**",
      "assets/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "angular.json",
      "tsconfig*.json",
      "Dockerfile",
      "Caddyfile",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
